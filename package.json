{
  "name": "formulalab-cosmetica",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --workspace app/backend run dev",
    "dev:frontend": "npm --workspace app/frontend run dev",
    "build": "npm --workspace app/backend run build && npm --workspace app/frontend run build",
    "test": "npm --workspace app/backend run test",
    "db:generate": "npm --workspace app/backend run db:generate",
    "db:migrate": "npm --workspace app/backend run db:migrate",
    "db:seed": "npm --workspace app/backend run db:seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
