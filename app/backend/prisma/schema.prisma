generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  activo
  inactivo
  archivado
}

enum DocumentStatus {
  pendiente
  procesando
  procesado
  requiere_revision
  rechazado
}

enum JobStatus {
  pendiente
  procesando
  completado
  fallido
}

enum DraftStatus {
  borrador
  aprobado
  rechazado
}

enum EvidenceType {
  documental
  inferido
}

enum ValidationStatus {
  pendiente
  validado
  corregido
  en_conflicto
  rechazado
}

enum FormulationFamilyStatus {
  activa
  en_desarrollo
  archivada
  obsoleta
}

enum FormulationVersionStatus {
  borrador
  en_revision
  aprobada
  rechazada
  obsoleta
}

enum IngredientSourceType {
  materia_prima_maestra
  provisional
}

enum RawMaterialMasterStatus {
  borrador
  en_revision
  validada
  archivada
}

enum RawMaterialVersionStatus {
  borrador
  en_revision
  validada
  rechazada
  obsoleta
}

enum RawMaterialDocumentType {
  pdf
  tds
  sds
  coa
  imagen
  articulo
  otro
}

enum InventoryLotStatus {
  pendiente_recepcion
  recibido
  cuarentena
  aprobado
  rechazado
  bloqueado
  agotado
  caducado
  archivado
}

enum InventoryMovementType {
  entrada
  salida
  ajuste_positivo
  ajuste_negativo
  transferencia
  reserva
  liberacion_reserva
  devolucion
  rechazo
  merma
}

enum ProductionOrderStatus {
  borrador
  planeada
  liberada
  en_proceso
  pausada
  terminada
  cancelada
}

enum ProductionPriority {
  baja
  media
  alta
  urgente
}

enum ProductionLogType {
  inicio
  fin
  pausa
  reanudacion
  incidencia
  observacion
  parametro
}

model Organization {
  id        String       @id @default(uuid())
  name      String
  status    EntityStatus @default(activo)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")
  users     User[]
  documents Document[]
  drafts    RawMaterialDraft[]
  auditLogs AuditLog[]
  rawMaterialMasters RawMaterialMaster[]
  formulationFamilies FormulationFamily[]
  formulationVersions FormulationVersion[]
  formulationPhases FormulationPhase[]
  formulationIngredients FormulationIngredient[]
  formulationComparisons FormulationVersionComparison[]
  rawMaterialVersions RawMaterialMasterVersion[]
  rawMaterialManufacturers RawMaterialManufacturer[]
  rawMaterialSuppliers RawMaterialSupplier[]
  rawMaterialProducts RawMaterialCommercialProduct[]
  rawMaterialPriceHistory RawMaterialPriceHistory[]
  costScenarios CostScenario[]
  costScenarioItems CostScenarioItem[]
  rawMaterialDocuments RawMaterialDocument[]
  rawMaterialLots RawMaterialLot[]
  warehouses InventoryWarehouse[]
  locations InventoryLocation[]
  movements InventoryMovement[]
  productionOrders ProductionOrder[]
  productionConsumptions ProductionConsumption[]
  productionLogs ProductionLog[]
  productionChecklistItems ProductionChecklistItem[]
  productionProcessParameters ProductionProcessParameter[]
  finishedProductLots FinishedProductLot[]
  productCategories ProductCategory[]
  productTypes ProductType[]
  knowledgeFamilies KnowledgeFormulationFamily[]
  formulationSubfamilies FormulationSubfamily[]
  productFamilyRelations ProductFamilyRelation[]
  familyGlossaryTerms FamilyGlossaryTerm[]
  productSearchTerms ProductSearchTerm[]
  guidedSelectionRules GuidedSelectionRule[]
  cosmeticNeeds CosmeticNeed[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String      @map("organization_id")
  email          String       @unique
  passwordHash   String       @map("password_hash")
  fullName       String       @map("full_name")
  status         EntityStatus @default(activo)
  lastLoginAt    DateTime?    @map("last_login_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  documents      Document[]
  drafts         RawMaterialDraft[]
  approvals      RawMaterialValidatedVersion[]
  auditLogs      AuditLog[]
  resetRequests  PasswordResetRequest[]
  formulationFamilies FormulationFamily[]
  formulationVersions FormulationVersion[]
  formulationApprovals FormulationVersion[] @relation("FormulationApprovals")
  formulationComparisons FormulationVersionComparison[]
  createdRawMaterialMasters RawMaterialMaster[]
  rawMaterialVersions RawMaterialMasterVersion[]
  rawMaterialApprovals RawMaterialMasterVersion[] @relation("RawMaterialApprovals")
  rawMaterialPriceHistory RawMaterialPriceHistory[]
  costScenarios CostScenario[]
  inventoryWarehouses InventoryWarehouse[]
  inventoryMovements InventoryMovement[]
  responsibleProductionOrders ProductionOrder[] @relation("ProductionResponsible")
  operatedProductionOrders ProductionOrder[] @relation("ProductionOperator")
  productionLogs ProductionLog[]
  productionConsumptions ProductionConsumption[]
  productionChecklistItems ProductionChecklistItem[]
  finishedProductLots FinishedProductLot[]

  @@index([organizationId])
  @@map("users")
}

model PasswordResetRequest {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  status    String    @default("preparado")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_requests")
}

model Document {
  id                String                 @id @default(uuid())
  organizationId    String                 @map("organization_id")
  uploadedByUserId  String                 @map("uploaded_by_user_id")
  originalFilename  String                 @map("original_filename")
  storedFilename    String                 @map("stored_filename")
  mimeType          String                 @map("mime_type")
  fileExtension     String                 @map("file_extension")
  sizeBytes         Int                    @map("size_bytes")
  storagePath       String                 @map("storage_path")
  status            DocumentStatus         @default(pendiente)
  rejectionReason   String?                @map("rejection_reason")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at")
  organization      Organization           @relation(fields: [organizationId], references: [id])
  uploadedBy        User                   @relation(fields: [uploadedByUserId], references: [id])
  processingJobs    DocumentProcessingJob[]
  extractedValues   ExtractedValue[]
  rawMaterialLinks  RawMaterialDocument[]
  inventoryMovements InventoryMovement[]

  @@index([organizationId])
  @@index([uploadedByUserId])
  @@map("documents")
}

model DocumentProcessingJob {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  documentId     String      @map("document_id")
  status         JobStatus   @default(pendiente)
  startedAt      DateTime?   @map("started_at")
  finishedAt     DateTime?   @map("finished_at")
  errorMessage   String?     @db.Text @map("error_message")
  createdAt      DateTime    @default(now()) @map("created_at")
  document       Document    @relation(fields: [documentId], references: [id])

  @@index([organizationId])
  @@index([documentId])
  @@map("document_processing_jobs")
}

model RawMaterialDraft {
  id                String                         @id @default(uuid())
  organizationId    String                         @map("organization_id")
  createdByUserId   String                         @map("created_by_user_id")
  status            DraftStatus                    @default(borrador)
  approvedVersionId String?                        @map("approved_version_id")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at")
  organization      Organization                   @relation(fields: [organizationId], references: [id])
  createdBy         User                           @relation(fields: [createdByUserId], references: [id])
  extractedValues   ExtractedValue[]
  versions          RawMaterialValidatedVersion[]

  @@index([organizationId])
  @@index([createdByUserId])
  @@map("raw_material_drafts")
}

model ExtractedValue {
  id                 String           @id @default(uuid())
  organizationId     String           @map("organization_id")
  draftId            String           @map("draft_id")
  documentId         String           @map("document_id")
  fieldKey           String           @map("field_key")
  fieldLabel         String           @map("field_label")
  value              String?          @db.Text
  sourceDocumentName String           @map("source_document_name")
  sourceReference    String           @map("source_reference")
  dataType           String           @map("data_type")
  evidenceType       EvidenceType     @default(documental) @map("evidence_type")
  confidence         Float
  validationStatus   ValidationStatus @default(pendiente) @map("validation_status")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")
  draft              RawMaterialDraft @relation(fields: [draftId], references: [id])
  document           Document         @relation(fields: [documentId], references: [id])

  @@index([organizationId])
  @@index([draftId])
  @@index([documentId])
  @@map("extracted_values")
}

model RawMaterialValidatedVersion {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  draftId          String           @map("draft_id")
  versionNumber    Int              @map("version_number")
  approvedByUserId String           @map("approved_by_user_id")
  approvedAt       DateTime         @default(now()) @map("approved_at")
  snapshotJson     Json             @map("snapshot_json")
  draft            RawMaterialDraft @relation(fields: [draftId], references: [id])
  approvedBy       User             @relation(fields: [approvedByUserId], references: [id])

  @@unique([draftId, versionNumber])
  @@index([organizationId])
  @@map("raw_material_validated_versions")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  action         String
  beforeJson     Json?        @map("before_json")
  afterJson      Json?        @map("after_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model RawMaterialMaster {
  id               String                  @id @default(uuid())
  organizationId   String                  @map("organization_id")
  permanentCode    String                  @map("permanent_code")
  commercialName   String?                 @map("commercial_name")
  commonName       String                  @map("common_name")
  inci             String?
  cas              String?
  ec               String?
  category         String?
  family           String?
  cosmeticFunction String?                 @map("cosmetic_function")
  status           RawMaterialMasterStatus @default(borrador)
  currentVersionId String?                 @map("current_version_id")
  createdByUserId  String?                 @map("created_by_user_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at")
  organization     Organization            @relation(fields: [organizationId], references: [id])
  createdBy        User?                   @relation(fields: [createdByUserId], references: [id])
  ingredients      FormulationIngredient[]
  versions         RawMaterialMasterVersion[]
  manufacturers    RawMaterialManufacturer[]
  suppliers        RawMaterialSupplier[]
  products         RawMaterialCommercialProduct[]
  documents        RawMaterialDocument[]
  lots             RawMaterialLot[]
  productionConsumptions ProductionConsumption[]

  @@unique([organizationId, permanentCode])
  @@index([organizationId])
  @@index([createdByUserId])
  @@map("raw_material_masters")
}

model RawMaterialMasterVersion {
  id                   String                   @id @default(uuid())
  organizationId       String                   @map("organization_id")
  rawMaterialMasterId  String                   @map("raw_material_master_id")
  versionNumber        Int                      @map("version_number")
  status               RawMaterialVersionStatus @default(borrador)
  commercialName       String?                  @map("commercial_name")
  commonName           String                   @map("common_name")
  inci                 String?
  cas                  String?
  ec                   String?
  category             String
  family               String?
  cosmeticFunction     String                   @map("cosmetic_function")
  description          String?                  @db.Text
  appearance           String?
  color                String?
  odor                 String?
  solubility           String?
  density              String?
  ph                   String?                  @map("pH")
  maxTemperature       String?                  @map("max_temperature")
  recommendedTemperature String?                @map("recommended_temperature")
  usageRange           String?                  @map("usage_range")
  storageConditions    String?                  @db.Text @map("storage_conditions")
  shelfLife            String?                  @map("shelf_life")
  contraindications    String?                  @db.Text
  compatibilities      String?                  @db.Text
  incompatibilities    String?                  @db.Text
  allergens            String?                  @db.Text
  observations         String?                  @db.Text
  examplesOfUse        String?                  @db.Text @map("examples_of_use")
  evidenceSummary      String?                  @db.Text @map("evidence_summary")
  confidenceLevel      String                   @default("pendiente") @map("confidence_level")
  approvedByUserId     String?                  @map("approved_by_user_id")
  approvedAt           DateTime?                @map("approved_at")
  snapshotJson         Json?                    @map("snapshot_json")
  createdByUserId      String                   @map("created_by_user_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at")
  organization         Organization             @relation(fields: [organizationId], references: [id])
  rawMaterial          RawMaterialMaster        @relation(fields: [rawMaterialMasterId], references: [id])
  createdBy            User                     @relation(fields: [createdByUserId], references: [id])
  approvedBy           User?                    @relation("RawMaterialApprovals", fields: [approvedByUserId], references: [id])

  @@unique([rawMaterialMasterId, versionNumber])
  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@index([createdByUserId])
  @@map("raw_material_master_versions")
}

model RawMaterialManufacturer {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  rawMaterialMasterId String            @map("raw_material_master_id")
  name                String
  country             String?
  status              EntityStatus      @default(activo)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  organization        Organization      @relation(fields: [organizationId], references: [id])
  rawMaterial         RawMaterialMaster @relation(fields: [rawMaterialMasterId], references: [id])
  products            RawMaterialCommercialProduct[]
  lots                RawMaterialLot[]

  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@map("raw_material_manufacturers")
}

model RawMaterialSupplier {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  rawMaterialMasterId String            @map("raw_material_master_id")
  name                String
  contact             String?
  status              EntityStatus      @default(activo)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  organization        Organization      @relation(fields: [organizationId], references: [id])
  rawMaterial         RawMaterialMaster @relation(fields: [rawMaterialMasterId], references: [id])
  products            RawMaterialCommercialProduct[]
  priceHistory        RawMaterialPriceHistory[]
  lots                RawMaterialLot[]

  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@map("raw_material_suppliers")
}

model RawMaterialCommercialProduct {
  id                  String                   @id @default(uuid())
  organizationId      String                   @map("organization_id")
  rawMaterialMasterId String                   @map("raw_material_master_id")
  manufacturerId      String?                  @map("manufacturer_id")
  supplierId          String?                  @map("supplier_id")
  tradeName           String                   @map("trade_name")
  sku                 String?
  permanentCode       String?                  @map("permanent_code")
  presentation        String?
  presentationQuantity Float?                  @map("presentation_quantity")
  unit                String?
  price               Float?
  taxRate             Float?                   @map("tax_rate")
  shippingCost        Float?                   @map("shipping_cost")
  minimumPurchase     Float?                   @map("minimum_purchase")
  priceValidUntil     DateTime?                @map("price_valid_until")
  quotedAt            DateTime?                @map("quoted_at")
  observations        String?                  @db.Text
  averageCost         Float?                   @map("average_cost")
  currency            String?                  @default("MXN")
  status              EntityStatus             @default(activo)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at")
  organization        Organization             @relation(fields: [organizationId], references: [id])
  rawMaterial         RawMaterialMaster        @relation(fields: [rawMaterialMasterId], references: [id])
  manufacturer        RawMaterialManufacturer? @relation(fields: [manufacturerId], references: [id])
  supplier            RawMaterialSupplier?     @relation(fields: [supplierId], references: [id])
  priceHistory        RawMaterialPriceHistory[]
  costScenarioItems   CostScenarioItem[]
  lots                RawMaterialLot[]

  @@unique([organizationId, permanentCode])
  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@index([manufacturerId])
  @@index([supplierId])
  @@map("raw_material_commercial_products")
}

model RawMaterialPriceHistory {
  id                  String                       @id @default(uuid())
  organizationId      String                       @map("organization_id")
  commercialProductId String                       @map("commercial_product_id")
  supplierId          String?                      @map("supplier_id")
  previousPrice       Float?                       @map("previous_price")
  newPrice            Float                        @map("new_price")
  currency            String                       @default("MXN")
  taxRate             Float?                       @map("tax_rate")
  shippingCost        Float?                       @map("shipping_cost")
  validUntil          DateTime?                    @map("valid_until")
  quotedAt            DateTime                     @default(now()) @map("quoted_at")
  reason              String?
  evidenceReference   String?                      @map("evidence_reference")
  createdByUserId     String                       @map("created_by_user_id")
  createdAt           DateTime                     @default(now()) @map("created_at")
  organization        Organization                 @relation(fields: [organizationId], references: [id])
  commercialProduct   RawMaterialCommercialProduct @relation(fields: [commercialProductId], references: [id])
  supplier            RawMaterialSupplier?         @relation(fields: [supplierId], references: [id])
  createdBy           User                         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@index([commercialProductId])
  @@index([supplierId])
  @@map("raw_material_price_history")
}

model CostScenario {
  id                   String             @id @default(uuid())
  organizationId       String             @map("organization_id")
  formulationVersionId String             @map("formulation_version_id")
  name                 String
  batchSize            Float              @map("batch_size")
  batchUnit            String             @default("g") @map("batch_unit")
  currency             String             @default("MXN")
  exchangeRate         Float              @default(1) @map("exchange_rate")
  exchangeRateDate     DateTime           @default(now()) @map("exchange_rate_date")
  providerStrategy     String             @default("precio_reciente") @map("provider_strategy")
  additionalCostsJson  Json               @map("additional_costs_json")
  marginPercent        Float              @default(0) @map("margin_percent")
  markupPercent        Float              @default(0) @map("markup_percent")
  subtotalIngredients  Float              @default(0) @map("subtotal_ingredients")
  subtotalAdditional   Float              @default(0) @map("subtotal_additional")
  totalCost            Float              @default(0) @map("total_cost")
  costPerKg            Float?             @map("cost_per_kg")
  wholesalePrice       Float?             @map("wholesale_price")
  retailPrice          Float?             @map("retail_price")
  suggestedPrice       Float?             @map("suggested_price")
  alertsJson           Json               @map("alerts_json")
  createdByUserId      String             @map("created_by_user_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  organization         Organization       @relation(fields: [organizationId], references: [id])
  formulationVersion   FormulationVersion @relation(fields: [formulationVersionId], references: [id])
  createdBy            User               @relation(fields: [createdByUserId], references: [id])
  items                CostScenarioItem[]

  @@index([organizationId])
  @@index([formulationVersionId])
  @@map("cost_scenarios")
}

model CostScenarioItem {
  id                  String                        @id @default(uuid())
  organizationId      String                        @map("organization_id")
  costScenarioId      String                        @map("cost_scenario_id")
  formulationIngredientId String                    @map("formulation_ingredient_id")
  commercialProductId String?                       @map("commercial_product_id")
  displayName         String                        @map("display_name")
  phase               String
  percentage          Float
  grams               Float
  currency            String                        @default("MXN")
  unitCost            Float?                        @map("unit_cost")
  lineCost            Float?                        @map("line_cost")
  costSharePercent    Float?                        @map("cost_share_percent")
  priceDate           DateTime?                     @map("price_date")
  traceJson           Json                          @map("trace_json")
  organization        Organization                  @relation(fields: [organizationId], references: [id])
  scenario            CostScenario                  @relation(fields: [costScenarioId], references: [id])
  formulationIngredient FormulationIngredient       @relation(fields: [formulationIngredientId], references: [id])
  commercialProduct   RawMaterialCommercialProduct? @relation(fields: [commercialProductId], references: [id])

  @@index([organizationId])
  @@index([costScenarioId])
  @@index([formulationIngredientId])
  @@map("cost_scenario_items")
}

model RawMaterialDocument {
  id                  String                  @id @default(uuid())
  organizationId      String                  @map("organization_id")
  rawMaterialMasterId String                  @map("raw_material_master_id")
  documentId          String?                 @map("document_id")
  title               String
  documentType        RawMaterialDocumentType @map("document_type")
  externalReference   String?                 @map("external_reference")
  status              EntityStatus            @default(activo)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at")
  organization        Organization            @relation(fields: [organizationId], references: [id])
  rawMaterial         RawMaterialMaster       @relation(fields: [rawMaterialMasterId], references: [id])
  document            Document?               @relation(fields: [documentId], references: [id])

  @@unique([rawMaterialMasterId, documentId])
  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@index([documentId])
  @@map("raw_material_documents")
}

model RawMaterialLot {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  rawMaterialMasterId String            @map("raw_material_master_id")
  commercialProductId String?           @map("commercial_product_id")
  supplierId          String?           @map("supplier_id")
  manufacturerId      String?           @map("manufacturer_id")
  permanentCode       String            @map("permanent_code")
  supplierLotNumber   String?           @map("supplier_lot_number")
  lotCode             String            @map("lot_code")
  receivedAt          DateTime?         @map("received_at")
  manufacturedAt      DateTime?         @map("manufactured_at")
  expirationDate      DateTime?         @map("expiration_date")
  expectedQuantity    Float?            @map("expected_quantity")
  receivedQuantity    Float             @default(0) @map("received_quantity")
  availableQuantity   Float             @default(0) @map("available_quantity")
  reservedQuantity    Float             @default(0) @map("reserved_quantity")
  unit                String            @default("g")
  unitCost            Float?            @map("unit_cost")
  currency            String            @default("MXN")
  exchangeRate        Float?            @map("exchange_rate")
  locationId          String?           @map("location_id")
  status              InventoryLotStatus @default(pendiente_recepcion)
  packageIntact       Boolean?          @map("package_intact")
  correctIdentification Boolean?        @map("correct_identification")
  appearance          String?
  color               String?
  odor                String?
  receptionDecision   String?           @map("reception_decision")
  observations        String?           @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  organization        Organization      @relation(fields: [organizationId], references: [id])
  rawMaterial         RawMaterialMaster @relation(fields: [rawMaterialMasterId], references: [id])
  commercialProduct   RawMaterialCommercialProduct? @relation(fields: [commercialProductId], references: [id])
  supplier            RawMaterialSupplier? @relation(fields: [supplierId], references: [id])
  manufacturer        RawMaterialManufacturer? @relation(fields: [manufacturerId], references: [id])
  location            InventoryLocation? @relation(fields: [locationId], references: [id])
  movements           InventoryMovement[]
  productionConsumptions ProductionConsumption[]

  @@unique([organizationId, permanentCode])
  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@index([commercialProductId])
  @@index([locationId])
  @@map("raw_material_lots")
}

model InventoryWarehouse {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  name           String
  code           String
  zone           String?
  status         EntityStatus        @default(activo)
  responsibleUserId String?          @map("responsible_user_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id])
