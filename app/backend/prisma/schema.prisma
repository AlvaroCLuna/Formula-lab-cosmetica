generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  activo
  inactivo
  archivado
}

enum DocumentStatus {
  pendiente
  procesando
  procesado
  requiere_revision
  rechazado
}

enum JobStatus {
  pendiente
  procesando
  completado
  fallido
}

enum DraftStatus {
  borrador
  aprobado
  rechazado
}

enum EvidenceType {
  documental
  inferido
}

enum ValidationStatus {
  pendiente
  validado
  corregido
  en_conflicto
  rechazado
}

enum FormulationFamilyStatus {
  activa
  en_desarrollo
  archivada
  obsoleta
}

enum FormulationVersionStatus {
  borrador
  en_revision
  aprobada
  rechazada
  obsoleta
}

enum IngredientSourceType {
  materia_prima_maestra
  provisional
}

enum RawMaterialMasterStatus {
  borrador
  en_revision
  validada
  archivada
}

enum RawMaterialVersionStatus {
  borrador
  en_revision
  validada
  rechazada
  obsoleta
}

enum RawMaterialDocumentType {
  pdf
  tds
  sds
  coa
  imagen
  articulo
  otro
}

enum InventoryLotStatus {
  pendiente_recepcion
  recibido
  cuarentena
  aprobado
  rechazado
  bloqueado
  agotado
  caducado
  archivado
}

enum InventoryMovementType {
  entrada
  salida
  ajuste_positivo
  ajuste_negativo
  transferencia
  reserva
  liberacion_reserva
  devolucion
  rechazo
  merma
}

enum ProductionOrderStatus {
  borrador
  planeada
  liberada
  en_proceso
  pausada
  terminada
  cancelada
}

enum ProductionPriority {
  baja
  media
  alta
  urgente
}

enum ProductionLogType {
  inicio
  fin
  pausa
  reanudacion
  incidencia
  observacion
  parametro
}

enum LabProjectStatus {
  borrador
  planeado
  activo
  pausado
  completado
  cancelado
  archivado
}

enum LabSampleStatus {
  preparada
  en_evaluacion
  aprobada
  rechazada
  agotada
  retenida
  archivada
}

enum LabTestStatus {
  pendiente
  en_proceso
  completado
  repetido
  invalidado
  aprobado_tecnicamente
}

enum LabReleaseDecision {
  aprobada
  aprobada_con_observaciones
  rechazada
  pendiente
}

enum QualitySpecStatus {
  borrador
  en_revision
  aprobada
  obsoleta
  archivada
}

enum QualityInspectionStatus {
  pendiente
  en_inspeccion
  en_cuarentena
  aprobado
  aprobado_con_observaciones
  rechazado
  bloqueado
}

enum QualityDecision {
  liberar
  reprocesar
  reclasificar
  devolver
  destruir
  usar_bajo_desviacion
  mantener_en_cuarentena
  rechazar
}

enum PurchaseRequestStatus {
  borrador
  enviada
  en_revision
  aprobada
  rechazada
  convertida
  cancelada
  cerrada
}

enum PurchaseOrderStatus {
  borrador
  pendiente_aprobacion
  aprobada
  enviada
  confirmada
  parcialmente_recibida
  recibida
  cerrada
  cancelada
}

enum PurchaseRfqStatus {
  borrador
  enviada
  respondida_parcialmente
  respondida
  vencida
  cancelada
  cerrada
}

enum CrmLeadStatus {
  nuevo
  contactado
  calificado
  en_seguimiento
  convertido
  descartado
  inactivo
}

enum CrmOpportunityStage {
  deteccion
  calificacion
  diagnostico
  propuesta
  negociacion
  ganada
  perdida
  pausada
}

enum SalesQuoteStatus {
  borrador
  enviada
  vista
  en_negociacion
  aceptada
  rechazada
  vencida
  cancelada
  convertida
}

enum SalesOrderStatus {
  borrador
  confirmado
  en_validacion
  en_preparacion
  en_produccion
  listo
  parcialmente_entregado
  entregado
  cancelado
  cerrado
}

model Organization {
  id        String       @id @default(uuid())
  name      String
  status    EntityStatus @default(activo)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")
  users     User[]
  documents Document[]
  documentTypes KdeDocumentType[]
  documentVersions DocumentVersion[]
  documentTags DocumentTag[]
  documentTagLinks DocumentTagLink[]
  documentRelations DocumentRelation[]
  documentChunks DocumentChunk[]
  ocrResults OcrResult[]
  documentStatusCatalog DocumentStatusCatalog[]
  documentPermissions DocumentPermission[]
  knowledgeSources KnowledgeSource[]
  drafts    RawMaterialDraft[]
  auditLogs AuditLog[]
  rawMaterialMasters RawMaterialMaster[]
  formulationFamilies FormulationFamily[]
  formulationVersions FormulationVersion[]
  formulationPhases FormulationPhase[]
  formulationIngredients FormulationIngredient[]
  formulationComparisons FormulationVersionComparison[]
  rawMaterialVersions RawMaterialMasterVersion[]
  rawMaterialManufacturers RawMaterialManufacturer[]
  rawMaterialSuppliers RawMaterialSupplier[]
  rawMaterialProducts RawMaterialCommercialProduct[]
  rawMaterialPriceHistory RawMaterialPriceHistory[]
  costScenarios CostScenario[]
  costScenarioItems CostScenarioItem[]
  rawMaterialDocuments RawMaterialDocument[]
  rawMaterialLots RawMaterialLot[]
  warehouses InventoryWarehouse[]
  locations InventoryLocation[]
  movements InventoryMovement[]
  productionOrders ProductionOrder[]
  productionConsumptions ProductionConsumption[]
  productionLogs ProductionLog[]
  productionChecklistItems ProductionChecklistItem[]
  productionProcessParameters ProductionProcessParameter[]
  finishedProductLots FinishedProductLot[]
  productCategories ProductCategory[]
  productTypes ProductType[]
  knowledgeFamilies KnowledgeFormulationFamily[]
  formulationSubfamilies FormulationSubfamily[]
  productFamilyRelations ProductFamilyRelation[]
  familyGlossaryTerms FamilyGlossaryTerm[]
  productSearchTerms ProductSearchTerm[]
  guidedSelectionRules GuidedSelectionRule[]
  cosmeticNeeds CosmeticNeed[]
  labProjects LabProject[]
  labSamples LabSample[]
  labTestPlans LabTestPlan[]
  labTestPlanItems LabTestPlanItem[]
  labTestMethods LabTestMethod[]
  labInstruments LabInstrument[]
  labTests LabTest[]
  labStabilityStudies LabStabilityStudy[]
  labStabilityPoints LabStabilityPoint[]
  labTimelineEvents LabTimelineEvent[]
  labNonConformities LabNonConformity[]
  labTechnicalReleases LabTechnicalRelease[]
  qualitySpecifications QualitySpecification[]
  qualitySpecificationCriteria QualitySpecificationCriterion[]
  qualitySamplingPlans QualitySamplingPlan[]
  qualityInspections QualityInspection[]
  qualityProcessControls QualityProcessControl[]
  qualityFinishedControls QualityFinishedControl[]
  qualityReleases QualityRelease[]
  qualityDeviations QualityDeviation[]
  qualityNonConformities QualityNonConformity[]
  qualityCapaActions QualityCapaAction[]
  qualityDispositions QualityDisposition[]
  qualityReports QualityReport[]
  purchaseRequests PurchaseRequest[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  purchaseRfqs PurchaseRfq[]
  purchaseQuotes PurchaseQuote[]
  purchaseComparisons PurchaseComparison[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseApprovals PurchaseApproval[]
  purchaseReceipts PurchaseReceipt[]
  purchaseReturns PurchaseReturn[]
  supplierEvaluations SupplierEvaluation[]
  supplySuggestions SupplySuggestion[]
  crmLeads CrmLead[]
  crmCustomers CrmCustomer[]
  crmContacts CrmContact[]
  crmActivities CrmActivity[]
  crmOpportunities CrmOpportunity[]
  salesProducts SalesProduct[]
  salesPriceLists SalesPriceList[]
  salesQuotes SalesQuote[]
  salesQuoteItems SalesQuoteItem[]
  salesApprovals SalesApproval[]
  salesOrders SalesOrder[]
  salesOrderItems SalesOrderItem[]
  salesDeliveries SalesDelivery[]
  salesSamples SalesSample[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String      @map("organization_id")
  email          String       @unique
  passwordHash   String       @map("password_hash")
  fullName       String       @map("full_name")
  status         EntityStatus @default(activo)
  lastLoginAt    DateTime?    @map("last_login_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  documents      Document[]
  documentVersions DocumentVersion[]
  documentRelations DocumentRelation[]
  ocrResults OcrResult[]
  documentPermissions DocumentPermission[]
  knowledgeSources KnowledgeSource[]
  drafts         RawMaterialDraft[]
  approvals      RawMaterialValidatedVersion[]
  auditLogs      AuditLog[]
  resetRequests  PasswordResetRequest[]
  formulationFamilies FormulationFamily[]
  formulationVersions FormulationVersion[]
  formulationApprovals FormulationVersion[] @relation("FormulationApprovals")
  formulationComparisons FormulationVersionComparison[]
  createdRawMaterialMasters RawMaterialMaster[]
  rawMaterialVersions RawMaterialMasterVersion[]
  rawMaterialApprovals RawMaterialMasterVersion[] @relation("RawMaterialApprovals")
  rawMaterialPriceHistory RawMaterialPriceHistory[]
  costScenarios CostScenario[]
  inventoryWarehouses InventoryWarehouse[]
  inventoryMovements InventoryMovement[]
  responsibleProductionOrders ProductionOrder[] @relation("ProductionResponsible")
  operatedProductionOrders ProductionOrder[] @relation("ProductionOperator")
  productionLogs ProductionLog[]
  productionConsumptions ProductionConsumption[]
  productionChecklistItems ProductionChecklistItem[]
  finishedProductLots FinishedProductLot[]
  labProjectsResponsible LabProject[] @relation("LabProjectResponsible")
  labSamplesResponsible LabSample[] @relation("LabSampleResponsible")
  labTestMethodsCreated LabTestMethod[]
  labInstrumentsResponsible LabInstrument[]
  labTestsAnalyst LabTest[] @relation("LabTestAnalyst")
  labTimelineEvents LabTimelineEvent[]
  labNonConformitiesResponsible LabNonConformity[] @relation("LabNonConformityResponsible")
  labTechnicalReleases LabTechnicalRelease[] @relation("LabReleaseResponsible")
  qualitySpecificationsResponsible QualitySpecification[] @relation("QualitySpecResponsible")
  qualitySamplingPlansResponsible QualitySamplingPlan[] @relation("QualitySamplingResponsible")
  qualityInspectionsResponsible QualityInspection[] @relation("QualityInspectionResponsible")
  qualityReleasesResponsible QualityRelease[] @relation("QualityReleaseResponsible")
  qualityDeviationsResponsible QualityDeviation[] @relation("QualityDeviationResponsible")
  qualityNonConformitiesResponsible QualityNonConformity[] @relation("QualityNcfResponsible")
  qualityCapaActionsResponsible QualityCapaAction[] @relation("QualityCapaResponsible")
  qualityDispositionsResponsible QualityDisposition[] @relation("QualityDispositionResponsible")
  qualityReportsCreated QualityReport[] @relation("QualityReportCreatedBy")
  purchaseRequestsRequested PurchaseRequest[] @relation("PurchaseRequester")
  purchaseRequisitionsResponsible PurchaseRequisition[] @relation("PurchaseRequisitionResponsible")
  purchaseOrdersResponsible PurchaseOrder[] @relation("PurchaseOrderResponsible")
  purchaseApprovals PurchaseApproval[] @relation("PurchaseApprovalApprover")
  purchaseReceiptsResponsible PurchaseReceipt[] @relation("PurchaseReceiptResponsible")
  purchaseReturnsResponsible PurchaseReturn[] @relation("PurchaseReturnResponsible")
  supplierEvaluationsResponsible SupplierEvaluation[] @relation("SupplierEvaluationResponsible")
  crmLeadsResponsible CrmLead[] @relation("CrmLeadResponsible")
  crmActivitiesCreated CrmActivity[] @relation("CrmActivityCreatedBy")
  crmActivitiesResponsible CrmActivity[] @relation("CrmActivityResponsible")
  crmOpportunitiesResponsible CrmOpportunity[] @relation("CrmOpportunityResponsible")
  salesApprovalsApprover SalesApproval[] @relation("SalesApprovalApprover")
  salesOrdersResponsible SalesOrder[] @relation("SalesOrderResponsible")
  salesDeliveriesResponsible SalesDelivery[] @relation("SalesDeliveryResponsible")
  salesSamplesResponsible SalesSample[] @relation("SalesSampleResponsible")

  @@index([organizationId])
  @@map("users")
}

model PasswordResetRequest {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  status    String    @default("preparado")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_requests")
}

model Document {
  id                String                 @id @default(uuid())
  organizationId    String                 @map("organization_id")
  uploadedByUserId  String                 @map("uploaded_by_user_id")
  permanentCode     String?                @unique @map("permanent_code")
  knowledgeCode     String?                @unique @map("knowledge_code")
  sourceCode        String?                @unique @map("source_code")
  title             String?
  documentTypeId    String?                @map("document_type_id")
  language          String?                @default("es")
  author            String?
  supplier          String?
  manufacturer      String?
  detectedEntity    String?                @map("detected_entity")
  documentDate      DateTime?              @map("document_date")
  keywordsJson      Json?                  @map("keywords_json")
  summary           String?                @db.Text
  pageCount         Int?                   @map("page_count")
  tableCount        Int?                   @map("table_count")
  imageCount        Int?                   @map("image_count")
  indexingStatus    String                 @default("pendiente") @map("indexing_status")
  currentVersionId  String?                @map("current_version_id")
  originalFilename  String                 @map("original_filename")
  storedFilename    String                 @map("stored_filename")
  mimeType          String                 @map("mime_type")
  fileExtension     String                 @map("file_extension")
  sizeBytes         Int                    @map("size_bytes")
  storagePath       String                 @map("storage_path")
  status            DocumentStatus         @default(pendiente)
  rejectionReason   String?                @map("rejection_reason")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at")
  organization      Organization           @relation(fields: [organizationId], references: [id])
  uploadedBy        User                   @relation(fields: [uploadedByUserId], references: [id])
  documentType      KdeDocumentType?       @relation(fields: [documentTypeId], references: [id])
  processingJobs    DocumentProcessingJob[]
  extractedValues   ExtractedValue[]
  rawMaterialLinks  RawMaterialDocument[]
  inventoryMovements InventoryMovement[]
  versions          DocumentVersion[]
  tagLinks          DocumentTagLink[]
  relations         DocumentRelation[]
  chunks            DocumentChunk[]
  ocrResults        OcrResult[]
  permissions       DocumentPermission[]
  knowledgeSources  KnowledgeSource[]
  labTestsEvidence  LabTest[]
  labNonConformitiesEvidence LabNonConformity[]
  qualitySpecificationsDocuments QualitySpecification[]
  qualityInspectionsEvidence QualityInspection[]
  qualityReleasesEvidence QualityRelease[]
  qualityDeviationsEvidence QualityDeviation[]
  qualityNonConformitiesEvidence QualityNonConformity[]
  qualityCapaEvidence QualityCapaAction[]
  qualityDispositionsEvidence QualityDisposition[]
  qualityReportsDocuments QualityReport[]
  purchaseRequestsDocuments PurchaseRequest[]
  purchaseRfqsDocuments PurchaseRfq[]
  purchaseQuotesDocuments PurchaseQuote[]
  purchaseOrdersDocuments PurchaseOrder[]
  purchaseReceiptsDocuments PurchaseReceipt[]
  purchaseReturnsDocuments PurchaseReturn[]
  crmLeadsDocuments CrmLead[]
  crmCustomersDocuments CrmCustomer[]
  crmActivitiesDocuments CrmActivity[]
  salesProductsDocuments SalesProduct[]
  salesQuotesDocuments SalesQuote[]
  salesOrdersDocuments SalesOrder[]
  salesDeliveriesDocuments SalesDelivery[]
  salesSamplesDocuments SalesSample[]

  @@index([organizationId])
  @@index([uploadedByUserId])
  @@index([documentTypeId])
  @@index([status])
  @@index([indexingStatus])
  @@map("documents")
}

model DocumentProcessingJob {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  documentId     String      @map("document_id")
  status         JobStatus   @default(pendiente)
  startedAt      DateTime?   @map("started_at")
  finishedAt     DateTime?   @map("finished_at")
  errorMessage   String?     @db.Text @map("error_message")
  createdAt      DateTime    @default(now()) @map("created_at")
  document       Document    @relation(fields: [documentId], references: [id])

  @@index([organizationId])
  @@index([documentId])
  @@map("document_processing_jobs")
}

model RawMaterialDraft {
  id                String                         @id @default(uuid())
  organizationId    String                         @map("organization_id")
  createdByUserId   String                         @map("created_by_user_id")
  status            DraftStatus                    @default(borrador)
  approvedVersionId String?                        @map("approved_version_id")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at")
  organization      Organization                   @relation(fields: [organizationId], references: [id])
  createdBy         User                           @relation(fields: [createdByUserId], references: [id])
  extractedValues   ExtractedValue[]
  versions          RawMaterialValidatedVersion[]

  @@index([organizationId])
  @@index([createdByUserId])
  @@map("raw_material_drafts")
}

model ExtractedValue {
  id                 String           @id @default(uuid())
  organizationId     String           @map("organization_id")
  draftId            String           @map("draft_id")
  documentId         String           @map("document_id")
  fieldKey           String           @map("field_key")
  fieldLabel         String           @map("field_label")
  value              String?          @db.Text
  sourceDocumentName String           @map("source_document_name")
  sourceReference    String           @map("source_reference")
  dataType           String           @map("data_type")
  evidenceType       EvidenceType     @default(documental) @map("evidence_type")
  confidence         Float
  validationStatus   ValidationStatus @default(pendiente) @map("validation_status")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")
  draft              RawMaterialDraft @relation(fields: [draftId], references: [id])
  document           Document         @relation(fields: [documentId], references: [id])

  @@index([organizationId])
  @@index([draftId])
  @@index([documentId])
  @@map("extracted_values")
}

model RawMaterialValidatedVersion {
  id               String           @id @default(uuid())
  organizationId   String           @map("organization_id")
  draftId          String           @map("draft_id")
  versionNumber    Int              @map("version_number")
  approvedByUserId String           @map("approved_by_user_id")
  approvedAt       DateTime         @default(now()) @map("approved_at")
  snapshotJson     Json             @map("snapshot_json")
  draft            RawMaterialDraft @relation(fields: [draftId], references: [id])
  approvedBy       User             @relation(fields: [approvedByUserId], references: [id])

  @@unique([draftId, versionNumber])
  @@index([organizationId])
  @@map("raw_material_validated_versions")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  action         String
  beforeJson     Json?        @map("before_json")
  afterJson      Json?        @map("after_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model RawMaterialMaster {
  id               String                  @id @default(uuid())
  organizationId   String                  @map("organization_id")
  permanentCode    String                  @map("permanent_code")
  commercialName   String?                 @map("commercial_name")
  commonName       String                  @map("common_name")
  inci             String?
  cas              String?
  ec               String?
  category         String?
  family           String?
  cosmeticFunction String?                 @map("cosmetic_function")
  status           RawMaterialMasterStatus @default(borrador)
  currentVersionId String?                 @map("current_version_id")
  createdByUserId  String?                 @map("created_by_user_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at")
  organization     Organization            @relation(fields: [organizationId], references: [id])
  createdBy        User?                   @relation(fields: [createdByUserId], references: [id])
  ingredients      FormulationIngredient[]
  versions         RawMaterialMasterVersion[]
  manufacturers    RawMaterialManufacturer[]
  suppliers        RawMaterialSupplier[]
  products         RawMaterialCommercialProduct[]
  documents        RawMaterialDocument[]
  lots             RawMaterialLot[]
  productionConsumptions ProductionConsumption[]

  @@unique([organizationId, permanentCode])
  @@index([organizationId])
  @@index([createdByUserId])
  @@map("raw_material_masters")
}

model RawMaterialMasterVersion {
  id                   String                   @id @default(uuid())
  organizationId       String                   @map("organization_id")
  rawMaterialMasterId  String                   @map("raw_material_master_id")
  versionNumber        Int                      @map("version_number")
  status               RawMaterialVersionStatus @default(borrador)
  commercialName       String?                  @map("commercial_name")
  commonName           String                   @map("common_name")
  inci                 String?
  cas                  String?
  ec                   String?
  category             String
  family               String?
  cosmeticFunction     String                   @map("cosmetic_function")
  description          String?                  @db.Text
  appearance           String?
  color                String?
  odor                 String?
  solubility           String?
  density              String?
  ph                   String?                  @map("pH")
  maxTemperature       String?                  @map("max_temperature")
  recommendedTemperature String?                @map("recommended_temperature")
  usageRange           String?                  @map("usage_range")
  storageConditions    String?                  @db.Text @map("storage_conditions")
  shelfLife            String?                  @map("shelf_life")
  contraindications    String?                  @db.Text
  compatibilities      String?                  @db.Text
  incompatibilities    String?                  @db.Text
  allergens            String?                  @db.Text
  observations         String?                  @db.Text
  examplesOfUse        String?                  @db.Text @map("examples_of_use")
  evidenceSummary      String?                  @db.Text @map("evidence_summary")
  confidenceLevel      String                   @default("pendiente") @map("confidence_level")
  approvedByUserId     String?                  @map("approved_by_user_id")
  approvedAt           DateTime?                @map("approved_at")
  snapshotJson         Json?                    @map("snapshot_json")
  createdByUserId      String                   @map("created_by_user_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at")
  organization         Organization             @relation(fields: [organizationId], references: [id])
  rawMaterial          RawMaterialMaster        @relation(fields: [rawMaterialMasterId], references: [id])
  createdBy            User                     @relation(fields: [createdByUserId], references: [id])
  approvedBy           User?                    @relation("RawMaterialApprovals", fields: [approvedByUserId], references: [id])

  @@unique([rawMaterialMasterId, versionNumber])
  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@index([createdByUserId])
  @@map("raw_material_master_versions")
}

model RawMaterialManufacturer {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  rawMaterialMasterId String            @map("raw_material_master_id")
  name                String
  country             String?
  status              EntityStatus      @default(activo)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  organization        Organization      @relation(fields: [organizationId], references: [id])
  rawMaterial         RawMaterialMaster @relation(fields: [rawMaterialMasterId], references: [id])
  products            RawMaterialCommercialProduct[]
  lots                RawMaterialLot[]

  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@map("raw_material_manufacturers")
}

model RawMaterialSupplier {
  id                  String            @id @default(uuid())
  organizationId      String            @map("organization_id")
  rawMaterialMasterId String            @map("raw_material_master_id")
  name                String
  contact             String?
  status              EntityStatus      @default(activo)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  organization        Organization      @relation(fields: [organizationId], references: [id])
  rawMaterial         RawMaterialMaster @relation(fields: [rawMaterialMasterId], references: [id])
  products            RawMaterialCommercialProduct[]
  priceHistory        RawMaterialPriceHistory[]
  lots                RawMaterialLot[]

  @@index([organizationId])
  @@index([rawMaterialMasterId])
  @@map("raw_material_suppliers")
}

model RawMaterialCommercialProduct {
  id                  String                   @id @default(uuid())
  organizationId      String                   @map("organization_id")
  rawMaterialMasterId String                   @map("raw_material_master_id")
  manufacturerId      String?                  @map("manufacturer_id")
  supplierId          String?                  @map("supplier_id")
  tradeName           String                   @map("trade_name")
  sku                 String?
  permanentCode       String?                  @map("permanent_code")
  presentation        String?
  presentationQuantity Float?                  @map("presentation_quantity")
  unit                String?
  price               Float?
  taxRate             Float?                   @map("tax_rate")
  shippingCost        Float?                   @map("shipping_cost")
  minimumPurchase     Float?                   @map("minimum_purchase")
  priceValidUntil     DateTime?                @map("price_valid_until")
  quotedAt            DateTime?                @map("quoted_at")
